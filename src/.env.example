# Exchanges
ACTIVE_EXCHANGES=binance,okx

# OKX transport mode
# 0 = standard public JSON WebSocket
# 1 = SBE binary feed (requires your own OKX API credentials)
OKX_USE_SBE=0

# Required only when OKX_USE_SBE=1
OKX_API_KEY_PARSER=
OKX_SECRET_PARSER=
OKX_PASSWORD_PARSER=

# Spread detection
START_TH=0.3
END_TH=0.001

# Baseline
BASELINE_BUCKET_MS=100
BASELINE_WINDOW_MIN=60
BASELINE_WARMUP_MIN=60

# Hold times
ENTER_HOLD_MS=0
EXIT_HOLD_MS=0

# Database
DB_PATH=spreads.db

# Logging
LOG_LEVEL=INFO